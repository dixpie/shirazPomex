# این فایل فقط الگو است. مقادیر واقعی و محرمانه را در فایل .env.local قرار بده
# (که در .gitignore است و هرگز کامیت نمی‌شود).

# آدرس اتصال به MongoDB (MongoDB Atlas یا سرور شخصی)
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/shirazpomex

# آدرس نهایی سایت (بدون اسلش انتهایی) - برای سئو، sitemap و og:url
NEXT_PUBLIC_SITE_URL=https://shirazpomex.ir

# اطلاعات تماس (در همه جای سایت استفاده می‌شود)
NEXT_PUBLIC_PHONE=09171234567
NEXT_PUBLIC_PHONE_DISPLAY=0917 123 4567
NEXT_PUBLIC_LANDLINE=07132001234
NEXT_PUBLIC_LANDLINE_DISPLAY=071-32001234
NEXT_PUBLIC_ADDRESS=شیراز، بلوار ...، نبش ...، نمایندگی رسمی پومکس
NEXT_PUBLIC_TELEGRAM=https://t.me/shirazpomex
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/shirazpomex
NEXT_PUBLIC_MAP_EMBED_URL=https://maps.google.com/maps?q=شیراز&output=embed

# ورود پنل مدیریت (حتما قبل از انتشار تغییر بده)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string
